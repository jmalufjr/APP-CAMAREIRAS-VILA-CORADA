# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service role key: NUNCA exponha no client. Usada apenas em Server Actions
# para criar/editar usuários camareiras (Supabase Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
