# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service role key: NUNCA exponha no client. Usada apenas em Server Actions
# para criar/editar usuários camareiras (Supabase Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Credenciais da API externa da Stays (App Center > API Externo > Chaves
# da API, na conta da pousada). NUNCA exponha no client — usadas só em
# Server Actions/rotinas server-side que buscam reservas (ver
# PRD_regrasdenegocio.md). STAYS_BASE_URL é o subdomínio da própria conta
# (campo "URL do sistema" naquela tela), não um host genérico da Stays.
STAYS_BASE_URL=https://sua-conta.stays.net
STAYS_CLIENT_ID=login-mostrado-na-tela-de-chaves-da-api
STAYS_CLIENT_SECRET=senha-mostrada-na-tela-de-chaves-da-api

# Segredo do cron de sincronização automática com a Stays
# (src/app/api/cron/stays-sync/route.ts + vercel.json). Só o Vercel Cron
# (que envia este valor como "Authorization: Bearer <valor>") e você mesmo
# (pra testar manualmente) devem conhecê-lo — gere um valor aleatório
# próprio, não reaproveite o de outro projeto.
CRON_SECRET=gere-um-valor-aleatorio-proprio
